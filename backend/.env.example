# =============================================================================
# ENVIRONMENT VARIABLES - Movie Reservation System
# =============================================================================
# 
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# =============================================================================


# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port number for the server to listen on
PORT=3000

# Environment: 'development', 'production', or 'test'
NODE_ENV=development


# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# 
# To create the database:
# 1. Open PostgreSQL terminal: psql -U postgres
# 2. Run: CREATE DATABASE movie_reservation;

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=movie_reservation


# =============================================================================
# JWT (JSON Web Token) CONFIGURATION
# =============================================================================
# 
# Secret key for signing JWTs
# Generate a secure random string: 
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars


# =============================================================================
# RAZORPAY PAYMENT GATEWAY
# =============================================================================
# 
# Get these from your Razorpay Dashboard:
# https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here


# =============================================================================
# EMAIL CONFIGURATION (Gmail)
# =============================================================================
# 
# For Gmail, you need to:
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use that App Password here (not your regular Gmail password)

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password


# =============================================================================
# FRONTEND URL (for password reset links, etc.)
# =============================================================================

FRONTEND_URL=http://localhost:3001


# =============================================================================
# OPTIONAL: Firebase (for push notifications)
# =============================================================================
# 
# Only needed if you're implementing push notifications
# Get this from Firebase Console > Project Settings > Service Accounts

# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
